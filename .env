# ============================================================
# LinkedIn 动态追踪器 - 配置模板
# 复制此文件为 .env 并填写真实信息
# ============================================================

# LinkedIn 账号（用于登录抓取动态，建议使用小号）
LINKEDIN_EMAIL=360142420@qq.com
LINKEDIN_PASSWORD=TangYiYe@123

# 要监控的 LinkedIn 用户主页链接
# 本人测试链接：https://www.linkedin.com/in/%E4%B8%80%E4%B9%9F-%E5%94%90-297422295/
# 追踪链接 https://www.linkedin.com/in/jianshu-dong-1191b9129/
TARGET_PROFILE_URL=https://www.linkedin.com/in/jianshu-dong-1191b9129/

# ---- 邮件通知设置（使用 Gmail）----
# 发件人 Gmail 地址
NOTIFY_EMAIL_SENDER=angustang19940304@gmail.com

# Gmail 应用专用密码（不是登录密码！）
# 获取方式：Google账号 → 安全性 → 两步验证 → 应用专用密码
NOTIFY_EMAIL_APP_PASSWORD=ehxhvwoykpefnwxr

# 接收通知的邮箱地址
NOTIFY_EMAIL_RECIPIENT=360142420@qq.com

# ---- 运行设置 ----
# 检查间隔（分钟），默认 60 分钟
CHECK_INTERVAL_MINUTES=5

# 是否以无头（后台）模式运行浏览器（true/false）
# 建议首次运行时设为 false，确认登录正常后再改为 true
HEADLESS=false

# 检测到 LinkedIn 安全验证后，最多等待人工处理的分钟数
SECURITY_CHALLENGE_WAIT_MINUTES=8

# Edge 会话目录（用于持久化登录态，减少反复验证）
SESSION_PROFILE_DIR=.edge_profile
